generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  nom                     String
  passwordHash            String
  couleur                 String          @default("#2563eb")
  creeLe                  DateTime        @default(now())
  boutiqueAccentColor     String          @default("#2563eb")
  boutiqueActive          Boolean         @default(false)
  boutiqueDescription     String?
  boutiqueLogoUrl         String?
  boutiqueNom             String?
  boutiqueSlug            String?         @unique
  boutiqueWhatsApp        String?
  orangeMoneyCodeMarchand String?
  orangeMoneyNomAffichage String?
  orangeMoneyNumero       String?
  orangeMoneyType         OrangeMoneyType @default(PARTICULIER)
  articles                Article[]
  categories              Categorie[]
  conversations           Conversation[]
}

model Categorie {
  id       String    @id @default(cuid())
  userId   String
  nom      String
  couleur  String    @default("#2563eb")
  ordre    Int       @default(0)
  creeLe   DateTime  @default(now())
  articles Article[]
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Article {
  id             String          @id @default(cuid())
  nom            String
  taille         String?
  couleur        String?
  prixAchat      Int
  prixVente      Int
  quantite       Int             @default(0)
  unite          String          @default("pièce")
  photoUrl       String?
  creeLe         DateTime        @default(now())
  userId         String
  categorieId    String?
  categorie      Categorie?      @relation(fields: [categorieId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  commandeLignes CommandeLigne[]
  mouvements     Mouvement[]

  @@index([userId])
  @@index([categorieId])
}

model Mouvement {
  id           String   @id @default(cuid())
  articleId    String
  type         String
  quantite     Int
  prixUnitaire Int
  date         DateTime @default(now())
  note         String?
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Commande {
  id                String          @id @default(cuid())
  vendeurId         String
  clientNom         String
  clientTelephone   String?
  clientAdresse     String?
  clientNote        String?
  total             Int
  statut            StatutCommande  @default(EN_ATTENTE_PAIEMENT)
  referencePaiement String?
  creeLe            DateTime        @default(now())
  valideeLe         DateTime?
  lignes            CommandeLigne[]

  @@index([vendeurId])
  @@index([statut])
  @@index([creeLe])
}

model CommandeLigne {
  id           String   @id @default(cuid())
  commandeId   String
  articleId    String
  quantite     Int
  prixUnitaire Int
  article      Article  @relation(fields: [articleId], references: [id])
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId])
}

enum OrangeMoneyType {
  MARCHAND
  PARTICULIER
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  EN_ATTENTE_VALIDATION
  CONFIRMEE
  ANNULEE
}

model Conversation {
  id       String    @id @default(cuid())
  userId   String
  titre    String    @default("Nouvelle discussion")
  creeLe   DateTime  @default(now())
  majLe    DateTime  @updatedAt
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([majLe])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" ou "assistant"
  contenu        String       @db.Text
  creeLe         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
